PORT=3000
NODE_ENV=development
# Paste the PostgreSQL connection string from Supabase > Connect.
# Prefer the Session pooler connection string for a hosted Node.js server.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
